# ----- Node defaults -----
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Environment files (never commit secrets)
.env
.env.*
!.env.example

# OS / editor artefacts
.DS_Store
Thumbs.db

# IDE / editor caches
.vscode/
.idea/

# ----- Framework specific -----
# Next.js build output
.next/
out/

# Production build folder (CRA / generic React)
build/
dist/

# Local Vercel / deployment artefacts
.vercel

# ----- Common testing & coverage -----
coverage/
.nyc_output/

# ----- Misc caches used by modern bundlers -----
.cache/
.parcel-cache/
.vite/   